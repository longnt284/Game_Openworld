		{"id": "flute_echo", "type": "echo", "pos": [-22, -150], "yaw": 0, "event_quest": "ev02_tieng_sao", "flag": "flute_heard", "silent_count": true,
			"title": "Tiếng sáo bên suối", "lines": ["Tiếng sáo ai thổi lẫn trong tiếng suối, réo rắt rồi trôi dần về phía tây.", "Theo bờ suối sẽ tới rặng trúc đổ — nơi tiếng sáo tắt hẳn."]},
		{"id": "echo_1", "type": "echo", "pos": [6, -173], "yaw": 0, "title": "Tiếng vọng ký ức",
			"lines": ["\"Tý, đưa ta cuộn dây đỏ. Phong ấn lại nứt rồi.\"", "Giọng một ông lão, khàn và mệt. Tiếng bước chân nhỏ chạy lên dốc."]},
		{"id": "echo_2", "type": "echo", "pos": [-24, -191], "yaw": 0, "title": "Tiếng vọng ký ức",
			"lines": ["\"Muốn cứu thung lũng thì phải trả bằng thứ gì đó. Ta đã trả bằng tuổi trẻ.\"", "\"Giờ ta chỉ còn ký ức… mà ký ức của ta cũng sắp cạn.\""]},
		{"id": "echo_3", "type": "echo", "pos": [41, -211], "yaw": 0, "title": "Tiếng vọng ký ức",
			"lines": ["\"Trạm gác này từng có mười người lính.\"", "\"Họ đều quên đường về nhà… vì ta.\""]},
		{"id": "diary_tower", "type": "diary", "pos": [43.5, -213], "yaw": 70, "title": "Nhật ký Tịch Phong",
			"lines": ["\"Thứ nằm dưới núi không phải yêu quái. Nó là cơn bão bị giam ba mươi năm.\"",
				"\"Phong ấn cần ký ức để giữ nó ngủ yên. Ta lấy của mình cho đến khi chẳng còn gì để lấy. Rồi ta lấy của làng.\"",
				"\"Trúc Tướng gác lối lên đền. Muốn qua, gõ chuông theo lời ru cũ: trúc xanh, đá cũ, nước trong.\"",
				"Một chiếc lông vũ trắng kẹp giữa trang cuối. Vừa chạm vào, cơ thể Lâm An nhẹ bẫng như gió."]},
		{"id": "chime_bamboo", "type": "chime", "pos": [-14, -283], "yaw": 40, "note": 1, "title": "Chuông trúc xanh"},
		{"id": "chime_stone", "type": "chime", "pos": [-4, -295], "yaw": 0, "note": 2, "title": "Chuông đá cũ"},
		{"id": "chime_water", "type": "chime", "pos": [5, -284], "yaw": -40, "note": 3, "title": "Chuông nước trong"},
		{"id": "memory_core", "type": "memory_core", "pos": [0, -347], "yaw": 0, "if": ["dead:boss_truc_tuong"], "title": "Ký ức cuối",
			"lines": ["Tịch Phong đứng trước chuông đồng, tay run. \"Nếu có ai đến được đây, xin hãy hiểu…\"",
				"\"Ta không thể để bão thoát ra. Nhưng ta cũng không thể bắt làng quên mãi. Hãy tìm cách thứ ba.\"",
				"Viên ngọc phong ấn rung lên. Trên núi, hồi chuông chiều nay không vang."]},
