; Open with the Godot version pinned in dependencies.json.
config_version=5

[application]
config/name="Vân Khê — Dư Âm Gió"
config/description="Game nhập vai hành động 3D của Nguyễn Thành Long"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]

window/size/mode=0
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/BeVietnamPro-Medium.ttf"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=20.0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="npc"
3d_physics/layer_5="hurt_player"
3d_physics/layer_6="hurt_enemy"
3d_physics/layer_7="interact"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.62, 0.73, 0.76, 1)

[input]

move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
attack={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1,"pressed":true)]}
block={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2,"pressed":true)]}
skill_1={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
skill_2={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
skill_ult={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":88)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
heal={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
use_item={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}
lock_on={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":3,"pressed":true),Object(InputEventKey,"physical_keycode":84)]}
open_map={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":77)]}
open_journal={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74)]}
open_inventory={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73)]}
save_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194336)]}
load_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194340)]}
toggle_debug={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194334)]}
pause_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventKey,"physical_keycode":80)]}

[shader_globals]

vk_wind={
"type": "vec2",
"value": Vector2(1, 0)
}
vk_wet={
"type": "float",
"value": 0.0
}
vk_night={
"type": "float",
"value": 0.0
}
vk_gloom={
"type": "float",
"value": 0.0
}
vk_sky={
"type": "color",
"value": Color(0.72, 0.88, 0.95, 1)
}
